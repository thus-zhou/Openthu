        "tests/security_regression/test_secret_markers.py::test_privacy_gate_rejects_markers_in_public_archives",
        "tests/security_regression/test_secret_markers.py::test_report_generator_never_echoes_raw_failure_values"
      ]
    },
    "synthetic_codec_refused": {
      "criterion": "生产入口尝试使用合成编码器时应确认无法启用",
      "cases": [
        "tests/security_regression/test_production_boundary.py::test_production_entry_cannot_enable_the_synthetic_codec"
      ]
    },
    "lost_upload_not_replayed": {
      "criterion": "上传已发出后响应丢失，重复调用不得增加远端写计数",
      "cases": [
        "tests/release_regression/test_fault_injection.py::test_lost_upload_response_never_increases_upload_count"
      ]
    },
    "cursor_scope_refused": {
      "criterion": "账号切换与游标跨范围使用应明确拒绝",
      "cases": [
        "tests/release_regression/test_scope_integrity.py::test_cursor_from_another_account_or_scope_is_refused"
      ]
    },
    "last_valid_record_recoverable": {
      "criterion": "损坏加密状态、轮换中断和磁盘失败后保留最后有效记录",
      "cases": [
        "tests/release_regression/test_fault_injection.py::test_rotation_interruption_keeps_the_last_valid_record"
      ]
    },
    "missing_pages_never_mass_delete": {
      "criterion": "来源缺页不能产生大量删除事件，也不能显示为没有待办",
      "cases": [
        "tests/release_regression/test_scope_integrity.py::test_incomplete_source_never_mass_deletes_or_reports_empty"
      ]
    },
    "clean_ci_start": {
      "criterion": "从干净 CI 环境启动时不依赖开发机器的路径和用户配置",
      "cases": [
        "tests/release_regression/test_clean_environment.py::test_mcp_server_starts_from_a_clean_home_without_user_config"
      ]
    },
    "optional_feature_off_keeps_legacy": {
      "criterion": "关闭可选新功能后旧工具目录和原主要查询仍可使用",
      "cases": [
        "tests/security_regression/test_production_boundary.py::test_disabling_optional_features_keeps_the_legacy_catalog_and_query"
      ]
