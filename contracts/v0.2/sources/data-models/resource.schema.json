{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openthu.invalid/contracts/v0.2/sources/data-models/resource.schema.json",
  "title": "Openthu v0.2 canonical resource",
  "description": "A course file, library book, database entry or external link normalized from one source. Stable identity comes from the source record id and the surrounding scope, never from the title or relative path.",
  "x-contract-version": "resource-v1",
  "x-owner": "2.3/Hermes",
  "x-status": "frozen",
  "x-semantics": "Internal normalized resource record. A resource may be associated with a course, but library books and database entries are not forced into a course.",
  "x-identity-rule": "resource_uid = <source_id>:RESOURCE:<source_record_id>. If the source record id is unavailable, resource_uid is null and identity_state is MISSING_STABLE_ID. Title and relative_path are display-only.",
  "x-unknown-values": {
    "source_record_id": null,
    "resource_uid": null,
    "course_uid": null,
    "mime_type": null,
    "byte_size": null,
    "sha256": null,
    "null_meaning": "not provided or not applicable; never guessed and never used as an identity"
  },
  "type": "object",
  "required": [
    "source_id",
    "source_record_id",
    "resource_uid",
    "resource_kind",
    "course_uid",
    "title",
    "relative_path",
    "mime_type",
    "byte_size",
    "sha256",
    "download_state",
    "identity_state",
    "source_evidence_id",
    "synthetic"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "source_record_id": {
      "type": ["string", "null"],
      "maxLength": 240
    },
    "resource_uid": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.-]{1,80}:RESOURCE:[A-Za-z0-9_.:-]{1,180}$",
      "maxLength": 280
    },
    "resource_kind": {
      "type": "string",
      "enum": ["COURSE_FILE", "LIBRARY_BOOK", "DATABASE", "EXTERNAL_LINK", "OTHER"]
    },
    "course_uid": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.-]{1,80}:COURSE:[A-Za-z0-9_.:-]{1,180}$",
      "maxLength": 280
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "relative_path": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "mime_type": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9.+-]+/[a-z0-9][a-z0-9.+-]+$",
      "maxLength": 120
    },
    "byte_size": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "download_state": {
      "type": "string",
      "enum": ["NOT_DOWNLOADED", "LIST_READ", "DOWNLOADED", "UNRESOLVED", "FAILED", "UNKNOWN"]
    },
    "identity_state": {
      "type": "string",
      "enum": ["STABLE", "MISSING_STABLE_ID", "CONFLICT"]
    },
    "source_updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source_evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"identity_state": {"const": "STABLE"}},
        "required": ["identity_state"]
      },
      "then": {
        "properties": {
          "source_record_id": {"type": "string", "minLength": 1},
          "resource_uid": {"type": "string"}
        }
      }
    },
    {
      "if": {
        "properties": {"identity_state": {"const": "MISSING_STABLE_ID"}},
        "required": ["identity_state"]
      },
      "then": {
        "properties": {"resource_uid": {"type": "null"}}
      }
    }
  ],
  "x-compatibility-sample": {
    "source_id": "learn.course_files",
    "source_record_id": "SYNTHETIC-FILE-1",
    "resource_uid": "learn.course_files:RESOURCE:SYNTHETIC-FILE-1",
    "resource_kind": "COURSE_FILE",
    "course_uid": "learn.courses:COURSE:2026-2027-1:SYNTHETIC-COURSE-1",
    "title": "合成课件.pdf",
    "relative_path": "合成章节/合成课件.pdf",
    "mime_type": "application/pdf",
    "byte_size": 102400,
    "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "download_state": "NOT_DOWNLOADED",
    "identity_state": "STABLE",
    "source_updated_at": "2026-11-16T12:00:00+00:00",
    "source_evidence_id": "learn.course_files",
    "warnings": [],
    "synthetic": true
  },
  "x-rejection-samples": [
    {
      "why": "a missing stable id cannot carry a fabricated resource_uid",
      "value": {
        "source_id": "learn.course_files",
        "source_record_id": null,
        "resource_uid": "learn.course_files:RESOURCE:SYNTHETIC-FILE-1",
        "resource_kind": "COURSE_FILE",
        "course_uid": null,
        "title": "合成课件.pdf",
        "relative_path": null,
        "mime_type": null,
        "byte_size": null,
        "sha256": null,
        "download_state": "UNRESOLVED",
        "identity_state": "MISSING_STABLE_ID",
        "source_evidence_id": "learn.course_files",
        "synthetic": true
      }
    },
    {
      "why": "a relative path is not a stable resource identifier",
      "value": {
        "source_id": "learn.course_files",
        "source_record_id": "SYNTHETIC-FILE-1",
        "resource_uid": "合成章节/合成课件.pdf",
        "resource_kind": "COURSE_FILE",
        "course_uid": null,
        "title": "合成课件.pdf",
        "relative_path": "合成章节/合成课件.pdf",
        "mime_type": "application/pdf",
        "byte_size": 102400,
        "sha256": null,
        "download_state": "LIST_READ",
        "identity_state": "STABLE",
        "source_evidence_id": "learn.course_files",
        "synthetic": true
      }
    }
  ]
}
