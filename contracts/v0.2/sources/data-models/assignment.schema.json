{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openthu.invalid/contracts/v0.2/sources/data-models/assignment.schema.json",
  "title": "Openthu v0.2 canonical assignment",
  "description": "A read-only assignment record. Submission state is intentionally separate from the upload/draft/final submit workflow record so a read cannot be mistaken for a write.",
  "x-contract-version": "assignment-v1",
  "x-owner": "2.3/Hermes",
  "x-status": "frozen",
  "x-semantics": "Internal normalized assignment read model. submitted and graded are source flags; submission_state is the interpreted read state, not a local submission receipt.",
  "x-identity-rule": "assignment_uid = <source_id>:ASSIGNMENT:<source_record_id>. base_record_id may identify the upstream detail record but does not replace the stable assignment id.",
  "x-unknown-values": {
    "deadline": null,
    "late_deadline": null,
    "submitted": null,
    "graded": null,
    "grade_value": null,
    "overdue": null,
    "null_meaning": "not provided or not inferable; never false and never zero by default"
  },
  "type": "object",
  "required": [
    "source_id",
    "source_record_id",
    "assignment_uid",
    "base_record_id",
    "course_uid",
    "title",
    "deadline",
    "late_deadline",
    "submitted",
    "graded",
    "grade_value",
    "submission_state",
    "instructions_state",
    "attachments_state",
    "overdue",
    "source_evidence_id",
    "synthetic"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "assignment_uid": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,80}:ASSIGNMENT:[A-Za-z0-9_.:-]{1,180}$",
      "maxLength": 280
    },
    "base_record_id": {
      "type": ["string", "null"],
      "maxLength": 240
    },
    "course_uid": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.-]{1,80}:COURSE:[A-Za-z0-9_.:-]{1,180}$",
      "maxLength": 280
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "deadline": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "late_deadline": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "submitted": {
      "type": ["boolean", "null"]
    },
    "graded": {
      "type": ["boolean", "null"]
    },
    "grade_value": {
      "type": ["number", "null"]
    },
    "grade_text": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "submission_state": {
      "type": "string",
      "enum": ["NOT_SUBMITTED", "SUBMITTED", "GRADED", "UNKNOWN"]
    },
    "instructions_state": {
      "type": "string",
      "enum": ["NOT_READ", "READ", "UNKNOWN"]
    },
    "attachments_state": {
      "type": "string",
      "enum": ["NOT_READ", "LIST_READ", "UNRESOLVED", "UNKNOWN"]
    },
    "overdue": {
      "type": ["boolean", "null"]
    },
    "source_evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"graded": {"const": true}},
        "required": ["graded"]
      },
      "then": {
        "properties": {"submission_state": {"const": "GRADED"}}
      }
    },
    {
      "if": {
        "properties": {
          "submitted": {"const": true},
          "graded": {"const": false}
        },
        "required": ["submitted", "graded"]
      },
      "then": {
        "properties": {"submission_state": {"const": "SUBMITTED"}}
      }
    },
    {
      "if": {
        "properties": {"submitted": {"const": false}},
        "required": ["submitted"]
      },
      "then": {
        "properties": {"submission_state": {"const": "NOT_SUBMITTED"}}
      }
    }
  ],
  "x-compatibility-sample": {
    "source_id": "learn.assignments",
    "source_record_id": "SYNTHETIC-ASSIGNMENT-1",
    "assignment_uid": "learn.assignments:ASSIGNMENT:SYNTHETIC-ASSIGNMENT-1",
    "base_record_id": "SYNTHETIC-BASE-1",
    "course_uid": "learn.courses:COURSE:2026-2027-1:SYNTHETIC-COURSE-1",
    "title": "合成作业",
    "deadline": "2026-11-20T23:59:00+08:00",
    "late_deadline": null,
    "submitted": true,
    "graded": false,
    "grade_value": null,
    "submission_state": "SUBMITTED",
    "instructions_state": "READ",
    "attachments_state": "LIST_READ",
    "overdue": false,
    "source_evidence_id": "learn.assignments",
    "warnings": [],
    "synthetic": true
  },
  "x-rejection-samples": [
    {
      "why": "a boolean source flag cannot contradict the interpreted submission state",
      "value": {
        "source_id": "learn.assignments",
        "source_record_id": "SYNTHETIC-ASSIGNMENT-1",
        "assignment_uid": "learn.assignments:ASSIGNMENT:SYNTHETIC-ASSIGNMENT-1",
        "base_record_id": null,
        "course_uid": null,
        "title": "合成作业",
        "deadline": null,
        "late_deadline": null,
        "submitted": false,
        "graded": false,
        "grade_value": null,
        "submission_state": "SUBMITTED",
        "instructions_state": "UNKNOWN",
        "attachments_state": "UNKNOWN",
        "overdue": null,
        "source_evidence_id": "learn.assignments",
        "synthetic": true
      }
    },
    {
      "why": "a graded assignment cannot be marked as merely submitted",
      "value": {
        "source_id": "learn.assignments",
        "source_record_id": "SYNTHETIC-ASSIGNMENT-1",
        "assignment_uid": "learn.assignments:ASSIGNMENT:SYNTHETIC-ASSIGNMENT-1",
        "base_record_id": null,
        "course_uid": null,
        "title": "合成作业",
        "deadline": null,
        "late_deadline": null,
        "submitted": true,
        "graded": true,
        "grade_value": 95,
        "submission_state": "SUBMITTED",
        "instructions_state": "READ",
        "attachments_state": "LIST_READ",
        "overdue": false,
        "source_evidence_id": "learn.assignments",
        "synthetic": true
      }
    }
  ]
}
