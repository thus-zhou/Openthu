{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openthu.invalid/contracts/v0.2/sources/data-models/grade.schema.json",
  "title": "Openthu v0.2 canonical course grade",
  "description": "A course-level academic grade record. A missing grade is null with state UNGRADED or UNKNOWN; it is never converted to a zero. Assignment grades remain a separate field on the assignment record.",
  "x-contract-version": "grade-v1",
  "x-owner": "2.3/Hermes",
  "x-status": "frozen",
  "x-semantics": "Internal normalized grade record for a course attempt. grade_value and grade_text are source-provided values; Openthu does not compute a GPA, credit total or rank from incomplete data.",
  "x-identity-rule": "grade_uid = <source_id>:GRADE:<semester_id>:<source_record_id>. The course association is a separate course_uid. If either stable identifier is unavailable, grade_uid is null and identity_state is MISSING_STABLE_ID.",
  "x-unknown-values": {
    "grade_value": null,
    "grade_text": null,
    "credits": null,
    "published_at": null,
    "null_meaning": "not published or not provided; never zero and never a pass"
  },
  "type": "object",
  "required": [
    "source_id",
    "source_record_id",
    "grade_uid",
    "course_uid",
    "semester_id",
    "grade_value",
    "grade_text",
    "grade_scale",
    "credits",
    "state",
    "published_at",
    "identity_state",
    "source_evidence_id",
    "synthetic"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "source_record_id": {
      "type": ["string", "null"],
      "maxLength": 240
    },
    "grade_uid": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.-]{1,80}:GRADE:[A-Za-z0-9_.:-]{1,180}$",
      "maxLength": 280
    },
    "course_uid": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.-]{1,80}:COURSE:[A-Za-z0-9_.:-]{1,180}$",
      "maxLength": 280
    },
    "semester_id": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "grade_value": {
      "type": ["number", "null"]
    },
    "grade_text": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "grade_scale": {
      "type": "string",
      "enum": ["NUMERIC_100", "GRADE_LEVEL", "PASS_FAIL", "UNKNOWN"]
    },
    "credits": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "state": {
      "type": "string",
      "enum": ["GRADED", "UNGRADED", "WITHHELD", "UNKNOWN"]
    },
    "published_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "identity_state": {
      "type": "string",
      "enum": ["STABLE", "MISSING_STABLE_ID", "CONFLICT"]
    },
    "source_evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"state": {"const": "GRADED"}},
        "required": ["state"]
      },
      "then": {
        "anyOf": [
          {"properties": {"grade_value": {"type": "number"}}},
          {"properties": {"grade_text": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    {
      "if": {
        "properties": {"identity_state": {"const": "STABLE"}},
        "required": ["identity_state"]
      },
      "then": {
        "properties": {
          "source_record_id": {"type": "string", "minLength": 1},
          "semester_id": {"type": "string", "minLength": 1},
          "grade_uid": {"type": "string"}
        }
      }
    },
    {
      "if": {
        "properties": {"identity_state": {"const": "MISSING_STABLE_ID"}},
        "required": ["identity_state"]
      },
      "then": {
        "properties": {"grade_uid": {"type": "null"}}
      }
    }
  ],
  "x-compatibility-sample": {
    "source_id": "academics.grades",
    "source_record_id": "SYNTHETIC-GRADE-1",
    "grade_uid": "academics.grades:GRADE:2026-2027-1:SYNTHETIC-GRADE-1",
    "course_uid": "learn.courses:COURSE:2026-2027-1:SYNTHETIC-COURSE-1",
    "semester_id": "2026-2027-1",
    "grade_value": 92,
    "grade_text": null,
    "grade_scale": "NUMERIC_100",
    "credits": 3,
    "state": "GRADED",
    "published_at": "2026-11-16T12:00:00+00:00",
    "identity_state": "STABLE",
    "source_evidence_id": "academics.grades",
    "warnings": [],
    "synthetic": true
  },
  "x-rejection-samples": [
    {
      "why": "a graded record without any source-provided grade is not a zero and is not valid",
      "value": {
        "source_id": "academics.grades",
        "source_record_id": "SYNTHETIC-GRADE-1",
        "grade_uid": "academics.grades:GRADE:2026-2027-1:SYNTHETIC-GRADE-1",
        "course_uid": null,
        "semester_id": "2026-2027-1",
        "grade_value": null,
        "grade_text": null,
        "grade_scale": "NUMERIC_100",
        "credits": 3,
        "state": "GRADED",
        "published_at": null,
        "identity_state": "STABLE",
        "source_evidence_id": "academics.grades",
        "synthetic": true
      }
    },
    {
      "why": "a missing stable grade id cannot carry a fabricated grade_uid",
      "value": {
        "source_id": "academics.grades",
        "source_record_id": null,
        "grade_uid": "academics.grades:GRADE:2026-2027-1:SYNTHETIC-GRADE-1",
        "course_uid": null,
        "semester_id": "2026-2027-1",
        "grade_value": 92,
        "grade_text": null,
        "grade_scale": "NUMERIC_100",
        "credits": 3,
        "state": "GRADED",
        "published_at": null,
        "identity_state": "MISSING_STABLE_ID",
        "source_evidence_id": "academics.grades",
        "synthetic": true
      }
    },
    {
      "why": "a string is not a numeric grade value",
      "value": {
        "source_id": "academics.grades",
        "source_record_id": "SYNTHETIC-GRADE-1",
        "grade_uid": "academics.grades:GRADE:2026-2027-1:SYNTHETIC-GRADE-1",
        "course_uid": null,
        "semester_id": "2026-2027-1",
        "grade_value": "92",
        "grade_text": null,
        "grade_scale": "NUMERIC_100",
        "credits": 3,
        "state": "GRADED",
        "published_at": null,
        "identity_state": "STABLE",
        "source_evidence_id": "academics.grades",
        "synthetic": true
      }
    }
  ]
}
