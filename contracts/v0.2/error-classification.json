{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openthu.invalid/contracts/v0.2/error-classification.json",
  "title": "Openthu v0.2 error classification",
  "description": "Stable internal error categories and retry semantics. New module-local codes must be registered here before they cross the business facade.",
  "x-contract-version": "error-classification-v1",
  "x-owner": "1.1/Hermes",
  "x-status": "frozen",
  "x-semantics": "Categories describe Openthu behavior, not school error codes. The original upstream status is retained in source evidence.",
  "required_error_fields": [
    "code",
    "category",
    "retryable",
    "automatic_replay_allowed",
    "user_action"
  ],
  "x-unknown-values": {
    "code": "UNKNOWN",
    "category": "INTERNAL",
    "retryable": false,
    "automatic_replay_allowed": false,
    "user_action": "CONTACT_SUPPORT",
    "note": "Unregistered codes are treated as INTERNAL and never replayed."
  },
  "categories": {
    "INPUT": {
      "description": "Malformed, missing, conflicting or unsupported caller input.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "FIX_INPUT"
    },
    "AUTH": {
      "description": "Missing, expired or rejected authentication, including MFA and session material.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "REAUTHENTICATE"
    },
    "PERMISSION": {
      "description": "Authenticated but not permitted, or a feature switch expressly disables the operation.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "CONTACT_SUPPORT"
    },
    "RATE_LIMIT": {
      "description": "Upstream or local concurrency limit. Waiting is required; writes still never replay automatically.",
      "retryable": true,
      "automatic_replay_allowed": false,
      "user_action": "WAIT"
    },
    "MAINTENANCE": {
      "description": "Declared maintenance or temporary service unavailability.",
      "retryable": true,
      "automatic_replay_allowed": false,
      "user_action": "WAIT"
    },
    "NETWORK": {
      "description": "Transport, gateway, browser runtime or timeout failure. No conclusion about remote business state.",
      "retryable": true,
      "automatic_replay_allowed": false,
      "user_action": "RETRY"
    },
    "UPSTREAM_CONTRACT": {
      "description": "The source responded but its structure, fields or business state no longer match the adapter contract.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "CHECK_REMOTE_RECORD"
    },
    "COMPLETENESS": {
      "description": "Snapshot, cursor or pagination scope is incomplete, stale or mismatched.",
      "retryable": true,
      "automatic_replay_allowed": false,
      "user_action": "RETRY"
    },
    "CONFLICT": {
      "description": "A plan, account, adapter, resource or local lock changed before the operation could proceed.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "FIX_INPUT"
    },
    "NOT_IMPLEMENTED": {
      "description": "The capability, adapter or host integration is not present in this build.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "CONTACT_SUPPORT"
    },
    "CANCELLED": {
      "description": "The caller cancelled before or during the operation. Cancellation does not prove a remote write was undone.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "NONE"
    },
    "INTERNAL": {
      "description": "Local storage, encryption, state machine or unexpected implementation failure.",
      "retryable": false,
      "automatic_replay_allowed": false,
      "user_action": "CONTACT_SUPPORT"
    }
  },
  "write_replay_policy": {
    "before_dispatch": "Retry only after fixing input or authorization; never bypass preflight.",
    "after_dispatch": "Never replay automatically. Read the remote record and reconcile exact business fields.",
    "unknown_remote_state": "Never replay. Keep UNKNOWN and provide the official reconciliation path.",
    "model_chat": "At most one refresh before output starts and only for a clear 401; never after output, quota, 403, timeout or network failure."
  },
